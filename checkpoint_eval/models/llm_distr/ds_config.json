{
    "train_batch_size": 4,
    "train_micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": 1,
    "zero_optimization": {},
    "wall_clock_breakdown": false,
    "gradient_clipping": 1.0,
    "fp16": {
      "enabled": true,
      "loss_scale": 0,
      "initial_scale_power": 1,
      "loss_scale_window": 1000
    },

    "optimizer": {
      "type": "Adam",
      "params": {
          "lr": 1.0e-4,
          "betas": [0.9, 0.999],
          "eps": 1.0e-6,
          "weight_decay": 0.01
      }
    }
  }
